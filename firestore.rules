rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Read role from Firestore users collection (set by Cloud Functions on first login)
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    // ROLE PREDICATES — read together as a unit
    //
    // Per docs/decisions.md §D-001: projectManager is a real role that acts as
    // GC's delegate for project-operational work. It is NOT permitted for billing,
    // settings, role management, or selection lock-break.
    //
    // The pragmatic implementation: isGC() includes projectManager for the
    // vast majority of rules (which are project-operational). Use the new
    // isGCOnly() predicate for billing/settings/admin paths that the PM
    // must NOT touch.
    //
    // This minimizes the change surface — existing isGC() usage everywhere
    // automatically grants PM the right access for project-operational paths.
    // The few financial/admin paths that need GC-only access are explicitly
    // listed in the comments below the helpers.

    function isProjectManager() {
      return isSignedIn() && getUserRole() == 'projectManager';
    }

    // isGCOnly() — true GC carve-out. Use for: billing writes, settings,
    // admin operations, selection-lock-break. PMs explicitly fail this.
    function isGCOnly() {
      return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'gc');
    }

    // isGC() — includes admin + gc + projectManager. The default predicate
    // for project-operational rules. Most rules in this file use this.
    function isGC() {
      return isSignedIn() && (
        getUserRole() == 'admin'
        || getUserRole() == 'gc'
        || getUserRole() == 'projectManager'
      );
    }

    // Convenience alias — same as isGC(). Kept for clarity in newer rules
    // that want explicit "staff" semantics (selections-design.md uses this).
    function isStaff() {
      return isGC();
    }

    // ── Project Manager scoping ──────────────────────────────────────────────
    // A PM is limited to the jobs they're assigned to (projects.assignedUserIds).
    // pmInList() checks a project doc already in hand (e.g. resource.data on the
    // projects collection). Admin/GC bypass scoping via isGCOnly().
    //
    // NOTE (intentional, documented): right now this scoping is applied only to
    // the projects/{projectId} document itself — the "gateway" the app loads
    // before showing any project. Project SUBcollections (rooms, selections,
    // rfis, draws, takeoffs, walkthroughs, …) are NOT yet PM-scoped because
    // their rules admit staff through isDesigner()/isSub(), which fall back to
    // isStaff()→isGC()→includes PM. Closing those requires reworking the shared
    // role predicates + per-collection client query changes, validated with the
    // Firestore rules emulator. See docs/pm-project-isolation-plan.md.
    function pmInList(projectData) {
      return isProjectManager()
        && 'assignedUserIds' in projectData
        && request.auth.uid in projectData.assignedUserIds;
    }

    function isClient() {
      return isSignedIn() && getUserRole() == 'client';
    }

    function isDesigner() {
      return isSignedIn() && (getUserRole() == 'designer' || isStaff());
    }

    function isSub() {
      return isSignedIn() && (getUserRole() == 'sub' || isStaff());
    }

    // ── Client ↔ project ownership ───────────────────────────────────────────
    // Projects key the homeowner by their CONTACT-doc id (contacts.linkedUserId
    // = auth.uid), NOT their Firebase uid — so the old `clientId == auth.uid`
    // check denied every real client. A client "owns" a record when its
    // clientId / clientIds matches their uid (legacy) OR the contact id linked
    // to their user profile (users/{uid}.linkedContactId). get()/exists() calls
    // on the same path are cached per evaluation, so this stays well under the
    // access-call limit.
    function clientLinkedContactId() {
      return isClient()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'linkedContactId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedContactId
        : null;
    }
    function clientOwns(data) {
      return isClient() && (
        data.clientId == request.auth.uid
        || (clientLinkedContactId() != null && (
              data.clientId == clientLinkedContactId()
              || ('clientIds' in data && data.clientIds is list && clientLinkedContactId() in data.clientIds)
            ))
      );
    }
    function clientOwnsProject(pid) {
      return clientOwns(get(/databases/$(database)/documents/projects/$(pid)).data);
    }

    // Users — each user reads/writes their own profile; admins can write any profile
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    // Projects — admin/GC do everything; a PM is scoped to assigned jobs;
    // clients see only their project; designers/subs see assigned.
    match /projects/{projectId} {
      // A PM only reads a project they're in (assignedUserIds); the designer/sub
      // clauses already require assignment, so there's no unscoped PM backdoor here.
      allow read: if isGCOnly()
        || pmInList(resource.data)
        || (clientOwns(resource.data))
        || (isDesigner() && request.auth.uid in resource.data.assignedUserIds)
        || (isSub() && request.auth.uid in resource.data.assignedUserIds);
      // Only admin/GC create new projects (D-001: PMs can't create/delete).
      allow create: if isGCOnly();
      // A PM may edit only a project they're assigned to; admin/GC any.
      allow update: if isGCOnly() || pmInList(resource.data);
      // The homeowner may confirm or request a correction on their build
      // location — only the buildLocation key, and only the status/notes/
      // confirmation fields. They cannot move the pin or change the address.
      allow update: if clientOwns(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buildLocation'])
        && request.resource.data.buildLocation.latitude == resource.data.buildLocation.latitude
        && request.resource.data.buildLocation.longitude == resource.data.buildLocation.longitude
        && request.resource.data.buildLocation.addressLine1 == resource.data.buildLocation.addressLine1
        && request.resource.data.buildLocation.status in ['confirmed', 'correction_requested'];
      allow delete: if isAdmin();

      // Build-location audit trail. Any project participant can append events;
      // GC + the project's client/designer/subs can read the history.
      match /locationEvents/{eventId} {
        allow read: if isGC()
          || (isSignedIn() && (
                clientOwnsProject(projectId)
                || request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.assignedUserIds));
        allow create: if isSignedIn();
        allow update, delete: if isGC();
      }
    }

    // Contacts (subs, employees, vendors)
    match /contacts/{contactId} {
      allow read: if isGC();
      allow create, update: if isGC();
      allow delete: if isAdmin();
      // Self-link (auto): signed-in user can stamp linkedUserId + linkedAt
      // on a contact whose email matches their auth email — covers the
      // happy-path auto-link on portal load.
      allow update: if request.auth != null
        && resource.data.email is string
        && request.auth.token.email is string
        && resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUserId', 'linkedAt'])
        && request.resource.data.linkedUserId == request.auth.uid;

      // Self-link (manual claim): signed-in user can claim an UNLINKED
      // contact doc (one with no linkedUserId yet) even if the email doesn't
      // match. Same field constraints — only linkedUserId + linkedAt can be
      // touched, and the linkedUserId must equal request.auth.uid. This
      // handles the case where a sub signs up with a different email from
      // what the GC put on their contact card.
      allow update: if request.auth != null
        && !('linkedUserId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUserId', 'linkedAt'])
        && request.resource.data.linkedUserId == request.auth.uid;
    }

    // CRM pipeline — leads and clients
    match /clients/{clientId} {
      allow read: if isGC() || isSignedIn(); // signed-in users can read for address matching on registration
      allow create, update: if isGC();
      allow delete: if isAdmin();
    }

    // Public site content (e.g. the giveaway page image). World-readable so the
    // public /giveaway page renders with no auth; only GC/admin can change it.
    match /public_content/{docId} {
      allow read: if true;
      allow write: if isGC();
    }

    // Sales-pitch one-pagers shown in the client portal before a project exists.
    // Any signed-in user (prospective clients included) can read; only staff
    // (admin/gc/pm) can curate the content from the portal.
    match /salesPitchSections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isGC();
    }

    // Pending trade requests (submitted during sub registration)
    match /pendingTrades/{tradeId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Approved trades list
    match /trades/{tradeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Estimates — linked to clients and jobs.
    // Financial. Read-blocked for PM per D-001 ("shouldn't have the
    // financials" — Tyler 2026-06): isGCOnly() excludes projectManager.
    // Clients still see their own estimate (price visibility on contract).
    match /estimates/{estimateId} {
      // Estimates key clientId as the sales clients-doc id (a third id shape),
      // so match by the project the estimate belongs to instead.
      allow read: if isGCOnly()
        || clientOwns(resource.data)
        || (isClient() && 'projectId' in resource.data && clientOwnsProject(resource.data.projectId));
      allow write: if isGCOnly();
      allow delete: if isAdmin();

      match /lineItems/{lineItemId} {
        allow read: if isGCOnly()
          || (isClient() && get(/databases/$(database)/documents/estimates/$(estimateId)).data.clientId == request.auth.uid);
        allow write: if isGCOnly();
        allow delete: if isAdmin();
      }
    }

    // Invoices — financial. Read-blocked for PM (isGCOnly). Clients see their own.
    match /invoices/{invoiceId} {
      allow read: if isGCOnly()
        || (clientOwns(resource.data));
      allow write: if isGCOnly();
      allow delete: if isAdmin();
    }

    // Client inspiration board — pre-project photos + notes a homeowner shares
    // for their designer to review (before a project exists). Owner reads their
    // own (by uid or linked contact id); GC + designers read all. The homeowner
    // creates their own items; owner or GC can remove.
    match /inspiration/{itemId} {
      allow read: if isGC() || isDesigner()
        || (isClient() && (
              resource.data.clientUid == request.auth.uid
              || (clientLinkedContactId() != null && resource.data.clientContactId == clientLinkedContactId())
            ));
      allow create: if isSignedIn() && request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if isGC()
        || (isSignedIn() && resource.data.clientUid == request.auth.uid);
    }

    // ── Style Discovery ──────────────────────────────────────────────────────
    // Curated global image library for the blind style-preference flow. Any
    // signed-in user can read (clients see the images; the style NAME is hidden
    // in the UI, not the data). Only admins curate the pool.
    match /styleLibrary/{imageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Per-contact like/pass reactions. Contact-scoped so leads can run Design
    // Discovery before a project exists. Mirrors /inspiration ownership.
    match /styleReactions/{reactionId} {
      allow read: if isGC() || isDesigner()
        || (isClient() && resource != null && (
              resource.data.clientUid == request.auth.uid
              || (clientLinkedContactId() != null && resource.data.clientContactId == clientLinkedContactId())
            ));
      allow create, update: if isSignedIn() && request.resource.data.clientUid == request.auth.uid;
      allow delete: if isGC() || (isSignedIn() && resource.data.clientUid == request.auth.uid);
    }

    // Computed style profile per contact (top styles + per-room lean). The
    // client writes their own; GC + designers read to know what to recommend.
    // Path-based ownership clause first so reading a not-yet-created profile
    // doesn't touch a null `resource`.
    match /styleProfiles/{contactId} {
      allow read: if isGC() || isDesigner()
        || (isClient() && clientLinkedContactId() != null && contactId == clientLinkedContactId())
        || (isClient() && resource != null && resource.data.clientUid == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.clientUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Bids — GC full access; subs can read+write their own portal-submitted bids;
    // public token bids still allowed for legacy flow
    match /bids/{bidId} {
      allow read: if isGC()
        || (isSub() && resource.data.subContactId == request.auth.uid);
      // Must be signed in; cannot self-award at creation time. (Was `if true`,
      // which allowed unauthenticated writes to the bids collection.)
      allow create: if isSignedIn()
        && request.resource.data.status != 'awarded';
      // Only admin/GC may set a bid to 'awarded'. A projectManager passes
      // isGC(), so without this carve-out they could self-award via a direct
      // Firestore write and bypass the approval queue. PMs may still update
      // bids (notes, etc.) as long as they don't flip status to 'awarded';
      // their awards go through /api/bids/award → pendingSubAssignments.
      allow update: if isGCOnly()
        || (isProjectManager() && request.resource.data.status != 'awarded')
        || (isSub() && resource.data.subContactId == request.auth.uid
            && request.resource.data.status != 'awarded'); // sub can revise but not self-award
      allow delete: if isGC();
    }

    // Pending sub assignments — a Project Manager's bid-award request awaiting
    // admin approval. Cloud Functions (admin SDK) create + resolve these via
    // /api/bids/award and /api/pending-sub-assignments/*; staff read the queue.
    // No direct client writes.
    match /pendingSubAssignments/{id} {
      allow read: if isGC();
      allow write: if false;
    }

    // Schedule tasks
    match /tasks/{taskId} {
      allow read: if isGC()
        || (isClient() && resource.data.visibleToClient == true)
        || (isSub() && resource.data.assignedSubId == request.auth.uid);
      allow write: if isGC();
    }

    // ── Master Task Library & Project Task Template system ────────────────────
    // masterTasks — the editable company library (TEMPLATES). Staff read for the
    // library board; only admins write. Heavy mutations (seed/create/edit/
    // archive/reorder) actually run through the api Cloud Function, whose Admin
    // SDK bypasses these rules; this gate covers any direct client access.
    match /masterTasks/{taskId} {
      allow read: if isGC();
      allow write: if isAdmin();
    }

    // projectTasks — INDEPENDENT per-project copies. Editing one never touches
    // the master. Staff read/write; clients see only client-visible tasks (clean
    // simplified portal view); subs see only subcontractor-visible tasks. Most
    // writes go through the api (server-side validation: skip-reason required,
    // quality-gate acceptance), but direct staff writes are allowed for liveness.
    match /projectTasks/{taskId} {
      allow read: if isGC()
        || (isClient() && resource.data.clientVisible == true)
        || (isSub() && resource.data.subcontractorVisible == true)
        || (isDesigner() && resource.data.designerVisible == true);
      allow create, update: if isGC();
      allow delete: if isGCOnly();
    }

    // taskImprovements — closeout lessons-learned suggestions awaiting admin
    // approval. Admin-only read; written exclusively by the api Cloud Function
    // (Admin SDK). Improvements are NEVER auto-applied to the master.
    match /taskImprovements/{impId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Messages and threads
    match /messages/{messageId} {
      // Author + staff only. (Was `if isSignedIn()`, which let any signed-in
      // user read every message in the system.) The live messaging UI reads
      // through the admin-SDK API, not direct Firestore reads, so this is a
      // direct-access hardening with no client-behavior change.
      allow read: if isGC()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isGC() || resource.data.authorId == request.auth.uid;
    }

    match /threads/{threadId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isGC();
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if isAdmin();
    }

    // Financial data (bills, financial transactions). Read-blocked for PM.
    match /financials/{docId} {
      allow read: if isGCOnly();
      allow write: if isGCOnly();
      allow delete: if isAdmin();
    }

    // Documents and photos
    match /documents/{docId} {
      allow read: if isGC()
        || (isClient() && resource.data.visibleToClient == true);
      allow write: if isGC();
      allow delete: if isAdmin();
    }

    // Change orders
    match /changeOrders/{orderId} {
      allow read: if isGC()
        || clientOwns(resource.data)
        || (isClient() && 'projectId' in resource.data && clientOwnsProject(resource.data.projectId));
      allow create: if isGCOnly() || isClient(); // clients create COs when approving overages
      allow update, delete: if isGCOnly();
    }

    // Safety forms
    match /safetyForms/{formId} {
      allow read: if isGC();
      allow write: if isGC() || isSub();
      allow delete: if isAdmin();
    }

    // Timesheets
    match /timesheets/{sheetId} {
      allow read: if isGC() || resource.data.userId == request.auth.uid;
      allow create, update: if isGC() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Project sub-collections: rooms
    match /projects/{projectId}/rooms/{roomId} {
      allow read: if isGC()
        || isDesigner()
        || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC() || isDesigner();
      allow delete: if isAdmin() || isGC();
    }

    // Project sub-collections: selections, schedules
    // Bid requests — audit log of outgoing bid requests to vendors
    // (Cloud Function writes these; GC/designer read; nobody else)
    match /projects/{projectId}/bidRequests/{requestId} {
      allow read: if isGC() || isDesigner();
      // Only Cloud Functions (admin SDK) write here; clients shouldn't.
      allow write: if false;
    }

    // Bid invite tokens — root-level lookup table for magic-link bid responses.
    // Per docs/sub-portal-design.md Slice 1. The token IS the auth for
    // looking up the bid request from the public endpoint. Clients must
    // never read this collection directly — Cloud Functions only.
    match /bidInviteTokens/{token} {
      allow read: if false;
      allow write: if false;
    }

    // Link review queue — staff-side queue of new sub signups whose contact
    // record couldn't be auto-linked. Per docs/decisions.md D-012-h.
    // Cloud Function writes entries; staff reads + resolves.
    match /linkReviewQueue/{entryId} {
      allow read: if isGC() || isAdmin();
      allow create: if false;          // Cloud Function only (admin SDK)
      allow update: if isGC() || isAdmin();   // staff marks resolved
      allow delete: if isAdmin();
    }

    match /projects/{projectId}/selections/{selectionId} {
      allow read: if isGC()
        || isDesigner()
        || (isClient() && clientOwnsProject(projectId));
      // Client can approve their own project's selections when not locked
      allow update: if isClient()
        && clientOwnsProject(projectId)
        && resource.data.get('locked', false) == false
        && request.resource.data.clientApprovalStatus == 'Approved';
      // GC can always write (lock/unlock, order status, finalize)
      allow create, update: if isGC();
      // Designer can write only when not locked
      allow create, update: if isDesigner() && resource.data.get('locked', false) == false;
      allow delete: if isAdmin() || isGC();
    }

    // Designer Portal — mood boards (one per room; items embedded as an array).
    // GC + designer curate; the client (project owner) reads + approves/requests
    // revisions (an update). Matches the collaborative selectionRecommendations
    // pattern below.
    match /projects/{projectId}/moodBoards/{boardId} {
      allow read: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow delete: if isGC() || isDesigner();
    }

    // Designer Portal — design decisions (room-by-room). GC + designer raise +
    // resolve; the client approves / rejects / requests revisions.
    match /projects/{projectId}/designDecisions/{decisionId} {
      allow read: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow delete: if isGC() || isDesigner();
    }

    // Designer Portal — file library metadata (the bytes live in Firebase
    // Storage under projects/{projectId}/rfis/... which storage.rules already
    // opens to authed users). Client may upload + read; GC/designer manage.
    match /projects/{projectId}/designFiles/{fileId} {
      allow read: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow delete: if isGC() || isDesigner();
    }

    // Style quiz answers — the homeowner's guided style preferences. The client
    // (project owner) reads/writes their own; GC + designer read to guide the
    // selections.
    match /projects/{projectId}/stylePreferences/{docId} {
      allow read: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow write: if isGC() || (isClient() && clientOwnsProject(projectId));
    }

    // Design Style Discovery — pairwise comparison results. Client (owner)
    // creates/reads their own; GC + designer read.
    match /projects/{projectId}/styleComparisons/{docId} {
      allow read: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC() || (isClient() && clientOwnsProject(projectId));
      allow delete: if isGC();
    }

    // Design Style Discovery — Other / Upload Inspiration submissions. Client
    // (owner) creates/reads their own; GC + designer read (+ mark reviewed).
    match /projects/{projectId}/styleInspiration/{docId} {
      allow read: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow delete: if isGC();
    }

    // "Recommended For You" — the bridge between Style Discovery and selections.
    // Client (owner) generates them + responds (love / not-for-me / upload photo);
    // GC + designer read + add/override. The recommendationTaskBridge Cloud
    // Function (admin SDK) creates/completes the linked client upload task.
    match /projects/{projectId}/selectionRecommendations/{docId} {
      allow read: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC() || isDesigner() || (isClient() && clientOwnsProject(projectId));
      allow delete: if isGC() || isDesigner();
    }

    match /projects/{projectId}/schedules/{scheduleId} {
      allow read: if isGC() || isDesigner()
        || (isClient() && clientOwnsProject(projectId));
      allow write: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Project messaging (Slack-like). Visibility is by channel membership:
    // a signed-in user sees a channel + its messages only if their uid is in
    // the channel's memberUids (GC/admin see everything). This keeps the
    // client's channels centralized and subs limited to channels they're in.
    match /projects/{projectId}/channels/{channelId} {
      allow read:   if isGC() || (isSignedIn() && request.auth.uid in resource.data.memberUids);
      allow create: if isGC() || (isSignedIn() && request.auth.uid in request.resource.data.memberUids);
      allow update: if isGC() || (isSignedIn() && request.auth.uid in resource.data.memberUids);
      allow delete: if isGC();

      match /messages/{messageId} {
        function channelMembers() {
          return get(/databases/$(database)/documents/projects/$(projectId)/channels/$(channelId)).data.memberUids;
        }
        allow read:   if isGC() || (isSignedIn() && request.auth.uid in channelMembers());
        allow create: if isGC() || (isSignedIn()
                          && request.auth.uid == request.resource.data.authorUid
                          && request.auth.uid in channelMembers());
        allow update, delete: if isGC() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // RFIs (Requests for Information) — cross-portal field questions/clarifications.
    // Subs/designers/GC raise them and read the log; GC + designers answer and
    // close. A creator may edit their own RFI. Internal to the build team — not
    // exposed to clients. Role-based (not per-project-membership), matching the
    // convention used by safetyForms/selections elsewhere in this file.
    match /projects/{projectId}/rfis/{rfiId} {
      allow read: if isGC() || isDesigner() || isSub();
      allow create: if isGC() || isDesigner() || isSub();
      allow update: if isGC() || isDesigner()
        || (isSub() && resource.data.createdByUid == request.auth.uid);
      allow delete: if isAdmin() || isGC();
    }

    // Draws (payment milestones) — clients can read their project's draws; GC manages.
    // Draws — financial. Read-blocked for PM (isGCOnly). Designer + the
    // project's client keep read access.
    match /projects/{projectId}/draws/{drawId} {
      allow read: if isGCOnly() || isDesigner()
        || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Budget vs Actual items per project — financial. Read-blocked for PM.
    match /projects/{projectId}/budgetItems/{itemId} {
      allow read: if isGCOnly()
        || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Takeoffs — plan measurements scoped to a project. Anyone who can create estimates
    // (GC/admin via isGC, plus designers) can read/write. Clients have no access.
    match /projects/{projectId}/takeoffs/{takeoffId} {
      allow read: if isGC() || isDesigner();
      allow create, update: if isGC() || isDesigner();
      allow delete: if isAdmin() || isGC();
    }

    // Lumber takeoffs — semantic layer on top of measurements: which wall, which
    // beam, materials math output. GC/admin only (designers don't need framing).
    match /projects/{projectId}/lumberTakeoffs/{lumberTakeoffId} {
      allow read: if isGC();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Saved description templates — reusable scope-of-work text shared across
    // the company. Used by the Estimate Details line-item picker.
    match /companySettings/{settingsDoc}/descriptionTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isGCOnly();
    }

    // Saved bid-package templates — reusable trade + scope groupings the GC
    // recycles across similar projects. Invited subs and due dates are NOT
    // captured (they're per-project). Read-broad so subs can preview what
    // standard scopes look like; only GC can mutate.
    match /bidPackageTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isGCOnly();
    }

    // Sub-scoped takeoffs — each subcontractor builds their own takeoff against
    // a project's plans for bidding purposes. Per-doc isolation: a sub can only
    // read/write their own takeoffs (matched on subUserId). GC can read all
    // (to surface attached measurements when reviewing bids).
    match /subTakeoffs/{takeoffId} {
      allow read: if isGC()
        || (isSignedIn() && resource.data.subUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.subUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.subUserId == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.subUserId == request.auth.uid);
    }

    // Bid Requests — invitations sent to subs to bid on a project scope.
    // GC creates/manages; invited subs read only requests where they're listed.
    // A user is matched if their Firebase Auth UID OR their auth email is in
    // the invitedSubIds array — the GC writes the array with the recipient's
    // contact ID + linkedUserId + email so any of those keys resolves.
    //
    // Note: we deliberately do NOT call isSub() here. Role lookups use a
    // get() inside the rule, which Firestore restricts for collectionGroup
    // queries — the rule can silently reject docs without surfacing an error,
    // making "no bids show" debugging impossible. Being explicitly invited
    // (by uid or auth email) is already a sufficient access gate.
    match /projects/{projectId}/bidRequests/{requestId} {
      allow read: if isGC() || isDesigner()
        || (isSignedIn() && (
              request.auth.uid in resource.data.invitedSubIds
              || (request.auth.token.email != null
                  && request.auth.token.email.lower() in resource.data.invitedSubIds)
            ));
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Bid Packages — wrap multiple bidRequests (one per trade) under one
    // project-wide invite. GC manages; subs can read packages they have at
    // least one bidRequest invite to (resolved client-side from bidRequests).
    match /projects/{projectId}/bidPackages/{packageId} {
      allow read: if isGC() || isDesigner() || isSub();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Dashboard reminders (e.g., "select a designer in 7 days"). Each is
    // scoped to a single GC user via ownerUid.
    match /reminders/{reminderId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Project reviews — clients submit; GC reads + approves + can mark shared.
    // The submitting client owns the doc via clientUid.
    match /projectReviews/{reviewId} {
      allow read: if isGC()
        || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.clientUid == request.auth.uid;
      allow update: if isGC();
      allow delete: if isAdmin();
    }

    // Single-doc settings (e.g., settings/google with placeId). GC manages.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isGCOnly();
    }

    // Playbook — Tyler's private internal journal of best practices, delay
    // causes, design tips, vendor recs. Admin/GC only. Surfacing to designers
    // or clients happens later by reading specific entries explicitly in
    // designer/client views, not by widening these rules.
    match /playbookEntries/{entryId} {
      allow read, write: if isGC();
    }

    // Top-level project schedule docs (Gantt module persistence). Each doc id
    // is a projectId. Clients/designers/subs need read access so they can see
    // the same Gantt the GC is editing; write stays GC-only.
    match /schedules/{projectId} {
      allow read: if isSignedIn();
      allow write: if isGC();
    }

    // Reusable schedule templates that the GC saves from the Gantt editor.
    match /scheduleTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isGC();
    }

    // Portal invites — tokens created by a GC that anonymous visitors can
    // resolve on the sign-in page to pre-fill email + auto-link to a contact
    // after they register. Read is open by design (a token is itself the
    // capability); write is GC-only.
    match /portalInvites/{inviteId} {
      allow read: if true;
      allow create, delete: if isGC();
      // GC can edit freely. Otherwise, the just-registered invitee may flip
      // ONLY their own invite (matched by email) to 'used' — nothing else —
      // so the one-time token is consumed at signup.
      allow update: if isGC() || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'claimedAt', 'claimedByUid'])
        && request.resource.data.status == 'used'
        && resource.data.email == request.auth.token.email
      );
    }

    // Portal-invite email templates — staff-managed library of selectable
    // templates (built-in seeds + GC uploads). Read/write is GC-only; the
    // backend send route reads them with admin privileges.
    match /emailTemplates/{templateId} {
      allow read, write: if isGC();
    }
    match /emailTemplates_meta/{docId} {
      allow read, write: if isGC();
    }

    // Client portal engagement log — append-only. Any signed-in portal user
    // records their own events (the event's uid must equal their own); only
    // staff read them (internal engagement view on the project overview).
    // No edits/deletes except admin cleanup.
    match /clientActivity/{eventId} {
      allow read: if isGC();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Walkthroughs — site media (photos/videos) captured on-site by GC, assigned to subs.
    // GC sees all; subs see only items assigned to them; designers can view (often related to selections).
    match /projects/{projectId}/walkthroughs/{walkthroughId} {
      allow read: if isGC() || isDesigner()
        || (isSub() && resource.data.assignedToContactId == request.auth.uid);
      allow create: if isGC();
      allow update: if isGC()
        || (isSub() && resource.data.assignedToContactId == request.auth.uid
            && request.resource.data.assignedToContactId == resource.data.assignedToContactId);
      allow delete: if isAdmin() || isGC();
    }

    // Permits & inspections — GC/admin manage; subs see read-only.
    match /permits/{permitId} {
      allow read: if isGC() || isSub();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Lot / land inventory — GC/admin only (sensitive financial data).
    match /lots/{lotId} {
      allow read: if isGC();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Subscriptions — paid services tracker. Contains API keys → admin-only access.
    match /subscriptions/{subId} {
      allow read, write: if isAdmin();
    }

    // Content Studio drafts — GC + admin + project managers manage; designers can read.
    match /contentDrafts/{draftId} {
      allow read: if isGC() || isDesigner();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Notifications — each user reads only their own. Any signed-in user can write
    // (so peer-to-peer notifications work without a backend). Updates are limited
    // to the recipient marking-as-read.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // App-wide settings (pipeline stages, etc.)
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isGCOnly();
    }

    // Site observation logs — GC/admin see all; clients create and read their own
    match /siteLogs/{logId} {
      allow read: if isGC();
      allow create: if isSignedIn();  // clients and team can create
      allow update: if isGC();        // GC marks resolved
      allow delete: if isAdmin();

      match /entries/{entryId} {
        allow read: if isGC()
          || (isClient() && get(/databases/$(database)/documents/siteLogs/$(logId)).data.createdBy == request.auth.uid);
        allow create: if isSignedIn();
        allow update, delete: if isGC();
      }
    }

    // Design board selections
    match /designSelections/{selectionId} {
      allow read: if isGC()
        || isDesigner()
        || (clientOwns(resource.data));
      allow write: if isGC() || isDesigner();
      allow delete: if isAdmin();
    }

    // Material catalog items
    match /catalogs/{itemId} {
      allow read: if isSignedIn();
      allow create, update: if isGC() || isDesigner();
      allow delete: if isAdmin() || isGC();
    }

    // Document & email templates
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();

      // Template subcollections (e.g. job templates' `jobTasks`). The catch-all
      // denies these otherwise, which would break applyJobTemplate + the
      // standard-task-list seeder.
      match /{sub=**} {
        allow read: if isSignedIn();
        allow write: if isGC();
      }
    }

    // Automations
    match /automations/{autoId} {
      allow read: if isGCOnly();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Social media posts
    match /socialPosts/{postId} {
      allow read: if isGC();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Purchase orders
    match /purchaseOrders/{poId} {
      allow read: if isGC()
        || (isSub() && resource.data.subId == request.auth.uid);
      allow create, update: if isGCOnly();
      allow delete: if isAdmin() || isGCOnly();
    }

    // Communications log
    match /commsLog/{logId} {
      allow read: if isGC();
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // Contracts — legal/financial spine. Each party can read their own.
    // GC reads/writes everything; client/sub/designer/employee read only
    // contracts where they are the `other` party (matched by uid).
    // Contracts — financial. Read-blocked for PM (isGCOnly). The counterparty
    // (sub/designer/client on the contract) keeps read access via userId.
    match /contracts/{contractId} {
      allow read: if isGCOnly()
        || (isSignedIn() && resource.data.other.userId == request.auth.uid);
      allow create, update: if isGCOnly();
      allow delete: if isAdmin();
    }

    // Move-in binder docs — owned by the project.
    match /projects/{projectId}/moveInBinder/{itemId} {
      allow read: if isGC()
        || (isClient() && clientOwnsProject(projectId));
      allow create, update: if isGC();
      allow delete: if isAdmin() || isGC();
    }

    // QuickBooks Online connection — single global doc holding access token,
    // refresh token, and realmId. Admin-only read because tokens are
    // sensitive; writes happen exclusively from the api Cloud Function via
    // Admin SDK (which bypasses these rules). OAuth state tokens (short
    // lived) live in a sibling collection, also Cloud-Function-managed.
    match /qboConnections/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Function only
    }
    match /qboOAuthStates/{docId} {
      allow read, write: if false; // Cloud Function only
    }

    // Ingestion Lab (spike) — admin-only namespace, fully isolated from
    // production collections. The single-rule wildcard below is the
    // isolation guarantee: every path under ingestion_lab/** is gated on
    // isAdmin() reads and Cloud-Function-only writes. The one specific
    // path that opens a write surface is processed_items, where the admin
    // UI updates review fields (Approve / Correct / Reject and Ask-queue
    // answer text).
    //
    // OAuth tokens (config doc) and OAuth state nonces are written
    // exclusively by the api Cloud Function via Admin SDK (which bypasses
    // these rules) — matches the qboConnections pattern at line 518.
    match /ingestion_lab/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin can update review fields on processed items from the UI
    // (Approve / Correct / Reject buttons, Ask-queue answer text). All
    // other fields are immutable from the client; the brain pass writes
    // them server-side via Admin SDK.
    match /ingestion_lab/data/processed_items/{itemId} {
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'reviewStatus',
               'reviewedAt',
               'reviewedByUid',
               'correction',
               'clarificationAnswer'
             ]);
    }

    // Notification automation job queue — delayed/multi-step notification steps
    // enqueued by fireTrigger and executed by the scheduled sweeper. Written and
    // read exclusively by Cloud Functions (Admin SDK bypasses these rules).
    match /notificationJobs/{jobId} {
      allow read, write: if false; // Cloud Function only
    }

    // SMS opt-out ledger — phone-keyed STOP/START state. Sensitive (raw phone
    // numbers); written exclusively by the api Cloud Function (Twilio inbound
    // webhook) and read by the notification dispatcher, both via Admin SDK
    // which bypasses these rules. No client access.
    match /sms_opt_outs/{phone} {
      allow read, write: if false; // Cloud Function only
    }

    // QA harness deploy lock — a single flag the api Cloud Function sets while a
    // QA run is in flight; deploy-on-push.yml reads it (publicly, via Firestore
    // REST) and aborts deploys while locked. Not sensitive (just a boolean +
    // reason), so world-readable; only the Cloud Function (Admin SDK) writes it.
    match /system/deployLock {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // QA run records — status + per-check results streamed in by the workflow.
    // Admins read them in the dashboard QA panel; only Cloud Functions write.
    match /qa_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Function only
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
